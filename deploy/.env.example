# PoliticalPredictor settings. Copy to .env and fill in; never share .env.
# Values containing $ (e.g. AUTH_PASSWORD_HASH) must be in 'single quotes'.

# --- Login (the app refuses to start until these are set) ------------------
AUTH_USERNAME=admin
# Either a plain password...
AUTH_PASSWORD=
# ...or, preferred, a hash of it (see INSTALL.md, "Set the login"). If set,
# AUTH_PASSWORD is ignored.
AUTH_PASSWORD_HASH=
# Random string of 32+ characters that signs login sessions.
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Session length in seconds (default 8 hours).
TOKEN_TTL_SECONDS=28800

# --- Database --------------------------------------------------------------
# Password for the bundled Postgres. Letters and digits only (it goes in a URL).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Leave empty to use the bundled database; or point at your own Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI model (see INSTALL.md, "The AI") ----------------------------------
# Karnak-6B on this machine (start with --profile local-ai). No data leaves it.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=hf.co/mradermacher/Karnak-6B-v1.0-GGUF:Q4_K_M
LLM_TIMEOUT=18000
# To use another OpenAI-compatible server instead (vLLM, in-house gateway...):
# LLM_BASE_URL=https://your-server/v1
# LLM_API_KEY=
# LLM_MODEL=
#
# Most tokens sent to the AI in one call. Longer documents are read in parts
# (the word scorer always reads everything). Raise it for a larger model.
# LLM_MAX_INPUT_TOKENS=7500

# --- Network ---------------------------------------------------------------
# Port the app is served on (http://<this-machine>:8080).
WEB_PORT=8080
# Failed logins allowed per IP within the window before lock-out.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

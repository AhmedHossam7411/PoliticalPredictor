# PoliticalPredictor settings. Copy to .env and fill in; never share .env.
# Values containing $ (e.g. AUTH_PASSWORD_HASH) must be in 'single quotes'.

# --- Login (the app refuses to start until these are set) ------------------
AUTH_USERNAME=admin
# Either a plain password...
AUTH_PASSWORD=
# ...or, preferred, a hash of it (see INSTALL.md, "Set the login"). If set,
# AUTH_PASSWORD is ignored.
AUTH_PASSWORD_HASH=
# Random string of 32+ characters that signs login sessions.
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Session length in seconds (default 8 hours).
TOKEN_TTL_SECONDS=28800

# --- Database --------------------------------------------------------------
# Password for the bundled Postgres. Letters and digits only (it goes in a URL).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Leave empty to use the bundled database; or point at your own Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI model (choose ONE option; see INSTALL.md, "Choose the AI") ---------
# Option A: Groq cloud (speech text is sent to Groq).
GROQ_API_KEY=
# Option B: model on this machine (start with --profile local-ai).
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=gpt-oss:20b
# LLM_TIMEOUT=300
# Option C: any other OpenAI-compatible server (vLLM, Azure OpenAI, ...).
# LLM_BASE_URL=https://your-server/v1
# LLM_API_KEY=
# LLM_MODEL=
#
# Most tokens sent to the AI in one call. Longer documents are sent as evenly
# spaced excerpts (the word scorer always reads everything). Defaults: 7500 on
# Groq, 14000 elsewhere. Raise it for a paid tier or a model with a larger context.
# LLM_MAX_INPUT_TOKENS=14000
#
# Groq only: models tried when the main one is rate-limited (comma-separated).
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- Network ---------------------------------------------------------------
# Port the app is served on (http://<this-machine>:8080).
WEB_PORT=8080
# Failed logins allowed per IP within the window before lock-out.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
